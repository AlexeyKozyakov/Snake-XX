<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".snake.ui.SnakeGameApplication"
        android:allowBackup="true"
        android:icon="@drawable/snake_green_xx"
        android:label="@string/app_name"
        android:roundIcon="@drawable/snake_green_xx"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnakeGameApplication"
        tools:targetApi="31">
        <activity
            android:name=".snake.ui.SnakeMainActivity"
            android:exported="true"
            android:theme="@style/Theme.SnakeGameApplicationSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">

            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
